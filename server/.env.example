# Copy this to .env and change what you need. ADMIN_PASSWORD is the only one
# you have to set.

# The admin page's password. It won't start without one.
ADMIN_PASSWORD=

# The server's name when it first starts. After that you change it on the
# admin page's Settings.
SERVER_NAME=SnapRacers server

# The ports. Phones join on GAME_PORT (UDP), web players on WS_PORT (TCP), and
# the admin page is on WEB_PORT.
GAME_PORT=27280
WS_PORT=27282
WEB_PORT=8080

# Only the admin page on this machine, say for behind a reverse proxy:
# WEB_BIND=127.0.0.1

# A certificate for web players, as they're seen inside the container (with
# ./certs mounted on /certs in docker-compose.yml). See the README.
# TLS_CERT=/certs/fullchain.pem
# TLS_KEY=/certs/privkey.pem

# The address to show players and put out on the local network, when it
# picks the wrong one (or you're on the bridge file).
# ADVERTISE_ADDRESS=192.168.1.20

# 0 to not put the server out on the local network for phones to find.
# LAN_DISCOVERY=1

# 1 when something in front of the admin page does HTTPS.
# HTTPS=0

# Godot
.godot/
/android/
*.import.tmp

# Tools downloaded locally (Godot editor and export templates)
/tools/godot/

# Builds
/build/
*.apk
*.aab
*.idsig

# Crash dumps. They're named core.<pid>, because a plain "core" pattern would
# also hide real folders.
core.[0-9]*

# The track design tools' downloaded map data and pictures, which they can
# make again.
/tools/track-design/*.json
!/tools/track-design/picks.json
/tools/track-design/*.png
/tools/track-design/*.svg
/tools/track-design/traced/
/tools/track-design/courses/*.png
/tools/track-design/__pycache__/
/tools/sound/__pycache__/

# The Android network plugin, built by tools/build-plugin.sh.
/addons/snapracers_net/bin/
